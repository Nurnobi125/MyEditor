<Window x:Class="VideoEditor.RecordingControlWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="MyEditor Recording Controls" Width="610" Height="142" MinWidth="560" MinHeight="142"
        WindowStyle="ToolWindow" ResizeMode="CanResizeWithGrip" ShowInTaskbar="False" Topmost="True"
        Background="#17191E" Foreground="#F1F3F6" WindowStartupLocation="Manual">
    <Border BorderBrush="#424856" BorderThickness="1" CornerRadius="12" Padding="12" Background="#1B1E25">
        <Grid>
            <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
            <DockPanel Grid.Row="0" LastChildFill="False" MouseLeftButtonDown="Header_MouseLeftButtonDown" Cursor="SizeAll">
                <TextBlock Text="MYEDITOR  ·  SCREEN RECORDING" Foreground="#B4A9FF" FontWeight="SemiBold" FontSize="11"/>
                <TextBlock x:Name="ElapsedText" DockPanel.Dock="Right" Text="00:00:00" FontFamily="Consolas" FontSize="16" FontWeight="SemiBold" Margin="12,0,0,0"/>
                <TextBlock x:Name="StateDot" DockPanel.Dock="Right" Text="●" Foreground="#F34B58" FontSize="13" Margin="0,0,7,0"/>
                <TextBlock x:Name="StateText" DockPanel.Dock="Right" Text="RECORDING" FontSize="11" FontWeight="Bold" VerticalAlignment="Center"/>
            </DockPanel>
            <TextBlock x:Name="FileText" Grid.Row="1" Text="Screen recording" Foreground="#AEB6C3" FontSize="10.5" TextTrimming="CharacterEllipsis" Margin="0,5,0,8"/>
            <DockPanel Grid.Row="2" LastChildFill="True">
                <Button x:Name="PauseResumeButton" DockPanel.Dock="Left" Content="Ⅱ  Pause" Width="112" Height="34" Margin="0,0,8,0" Click="PauseResume_Click" Background="#303746" Foreground="White" BorderThickness="0"/>
                <Button DockPanel.Dock="Left" Content="■  Stop &amp; open in editor" Width="190" Height="34" Click="Stop_Click" Background="#B83350" Foreground="White" FontWeight="SemiBold" BorderThickness="0"/>
                <TextBlock x:Name="StatsText" Text="" Foreground="#62D5E1" FontFamily="Consolas" FontSize="10" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="10,0,0,0" TextTrimming="CharacterEllipsis"/>
            </DockPanel>
        </Grid>
    </Border>
</Window>
